# Connexion PostgreSQL Neon : copie la valeur depuis la console Neon.
DATABASE_URL=
# Mot de passe d’administration : choisis au moins 16 caractères.
ADMIN_PASSWORD=
# Secret aléatoire de session : au moins 32 caractères, différent du mot de passe.
SESSION_SECRET=
# Jeton ajouté par Vercel lors de la connexion d’un stockage Blob PUBLIC.
BLOB_READ_WRITE_TOKEN=
